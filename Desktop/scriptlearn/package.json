{
  "name": "scriptlearn",
  "version": "0.21.0",
  "description": "Logiciel d'apprentissage du scripting Bash & PowerShell",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node dev.js",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:check": "node scripts/check-content.mjs",
    "toolchains": "node scripts/fetch-toolchains.mjs && node scripts/fetch-rust.mjs",
    "prepackage": "npm run toolchains",
    "package": "electron-vite build && electron-builder",
    "verify": "npm run lint && npm run test && npm run content:check && npm run build"
  },
  "build": {
    "appId": "com.scriptlearn.app",
    "productName": "ScriptLearn",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "node_modules/node-pty/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "**/v86/**",
      "**/sqljs/**"
    ],
    "extraResources": [
      { "from": "resources/go", "to": "go" },
      { "from": "resources/node", "to": "node" },
      { "from": "resources/python", "to": "python" },
      { "from": "resources/php", "to": "php" },
      { "from": "resources/mingw", "to": "mingw" },
      { "from": "resources/jdk", "to": "jdk" },
      { "from": "resources/git", "to": "git" },
      { "from": "resources/rust", "to": "rust" }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ScriptLearn",
      "include": "installer/custom.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "Emixee",
      "repo": "ScriptLearn"
    }
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.10.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/view": "^6.34.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@uiw/react-codemirror": "^4.25.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "js-yaml": "^4.2.0",
    "marked": "^18.0.4",
    "node-pty": "^1.1.0",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^32.3.3",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "vitest": "^2.1.4"
  }
}
